<?xml version="1.0" encoding="utf-8"?>
<!-- Lumina brand splash, shown before the Flutter engine draws its first
     frame — see lib/core/widgets/splash_screen.dart for the fully
     theme-aware screen that takes over immediately after. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
