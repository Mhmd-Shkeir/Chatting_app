rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Uniqueness registry: the document ID *is* the (lowercased) username,
    // so "create fails if it already exists" is what actually enforces
    // uniqueness. Permanent once claimed — no update/delete, since changing
    // usernames isn't a supported flow.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      // `get` must tolerate a conversation that doesn't exist yet: getOrCreateConversation()
      // checks existence before creating, and resource.data is null for a doc that isn't
      // there, so a naive "auth.uid in resource.data.participants" throws instead of
      // just denying. `list` results always exist (they matched a query), so no exists()
      // guard is needed there.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
            || request.auth.uid in resource.data.participants);

      allow list, update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // >= 2 covers both a direct conversation (exactly 2) and a group
      // (creator + at least one member) at creation time. Adding members
      // to a group later is just another participants/participantNames
      // update, already covered by the `update` rule above.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Eight distinct people/reasons are allowed to update a message
        // after it's created — message content itself (text, senderId,
        // timestamp) stays immutable in all of them:
        //   1. Any recipient marking "delivered" — status only. (Per-user
        //      "read" is now tracked separately, see 8.)
        //   2. The sender finishing their own pending image upload — status
        //      and imageUrl only, and only while the message is still
        //      mid-flight (status still 'sending' or a previously failed
        //      'failed' attempt being retried) — once a status of 'sent' is
        //      written, this same rule can no longer match for that sender,
        //      since resource.data.status is neither 'sending' nor 'failed'
        //      anymore, so a completed image message can't be rewritten
        //      later either.
        //   3. Any participant (including the sender) setting/clearing
        //      their own reaction — only the reactions map may change, and
        //      within it only their own uid key, so nobody can touch
        //      someone else's reaction.
        //   4. Any participant caching a translation of the (immutable)
        //      original text — only the translations map may change. This
        //      is shared cache, not per-user state (a translation for a
        //      given language is the same for everyone), so unlike
        //      reactions there's no per-key ownership restriction — any
        //      participant may add or overwrite any language's entry.
        //   5. The sender editing their own text message — text + edited
        //      only. get('type','text') treats a missing type field as
        //      text, since original text messages never wrote that key.
        //   6. The sender deleting their own message for everyone — clears
        //      content and flags it; the doc itself stays (no hard delete).
        //   7. Any participant deleting a message "for me" — same
        //      per-key-ownership shape as reactions, but on deletedFor.
        //   8. Any recipient marking a message as read *by them*
        //      specifically — same per-key-ownership shape as reactions,
        //      but on readBy. A group message only counts as fully "read"
        //      once every member's own key is present (see
        //      Message.isReadByAll), which one person's write here can
        //      never fake for anyone else.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            (request.auth.uid != resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (request.auth.uid == resource.data.senderId
              && resource.data.status in ['sending', 'failed']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'imageUrl', 'audioUrl']))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.reactions.diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['translations'])
            || (request.auth.uid == resource.data.senderId
              && resource.data.get('type', 'text') == 'text'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']))
            || (request.auth.uid == resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrl', 'audioUrl', 'deletedForEveryone']))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
              && request.resource.data.deletedFor.diff(resource.data.get('deletedFor', {})).affectedKeys().hasOnly([request.auth.uid]))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid]))
          );
      }
    }
  }
}
