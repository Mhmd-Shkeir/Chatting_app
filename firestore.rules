rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Uniqueness registry: the document ID *is* the (lowercased) username,
    // so "create fails if it already exists" is what actually enforces
    // uniqueness. Permanent once claimed — no update/delete, since changing
    // usernames isn't a supported flow.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      // `get` must tolerate a conversation that doesn't exist yet: getOrCreateConversation()
      // checks existence before creating, and resource.data is null for a doc that isn't
      // there, so a naive "auth.uid in resource.data.participants" throws instead of
      // just denying. `list` results always exist (they matched a query), so no exists()
      // guard is needed there.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
            || request.auth.uid in resource.data.participants);

      allow list, update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Two distinct people are allowed to update a message after it's
        // created, for two distinct reasons — message content itself (text,
        // senderId, timestamp) stays immutable in both cases:
        //   1. The recipient (never the sender) marking read receipts —
        //      status only.
        //   2. The sender finishing their own pending image upload — status
        //      and imageUrl only, and only while the message is still
        //      mid-flight (status still 'sending' or a previously failed
        //      'failed' attempt being retried) — once a status of 'sent' is
        //      written, this same rule can no longer match for that sender,
        //      since resource.data.status is neither 'sending' nor 'failed'
        //      anymore, so a completed image message can't be rewritten
        //      later either.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            (request.auth.uid != resource.data.senderId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            || (request.auth.uid == resource.data.senderId
              && resource.data.status in ['sending', 'failed']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'imageUrl']))
          );
      }
    }
  }
}
