rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Uniqueness registry: the document ID *is* the (lowercased) username,
    // so "create fails if it already exists" is what actually enforces
    // uniqueness. Permanent once claimed — no update/delete, since changing
    // usernames isn't a supported flow.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      // `get` must tolerate a conversation that doesn't exist yet: getOrCreateConversation()
      // checks existence before creating, and resource.data is null for a doc that isn't
      // there, so a naive "auth.uid in resource.data.participants" throws instead of
      // just denying. `list` results always exist (they matched a query), so no exists()
      // guard is needed there.
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
            || request.auth.uid in resource.data.participants);

      allow list, update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Read receipts: only the recipient (never the original sender) may
        // mark a message read, and only the status field may change — the
        // message content itself stays immutable.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.auth.uid != resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      }
    }
  }
}
